---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { type Lang, langs, t } from '../../i18n/ui';
import omniImage from '../../assets/omni/cosmic-web.jpg';

export function getStaticPaths() {
	return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<SiteLayout lang={lang} title={t(lang, 'home.title')} description={t(lang, 'home.lead')} path="">
	<section class="wrap home-hero">
		<h1>AloneCraft</h1>
		<p class="lead">{t(lang, 'home.lead')}</p>
	</section>

	<section class="wrap section">
		<h2>{t(lang, 'home.products')}</h2>
		<a class="product-card" href={`/${lang}/omni/`}>
			<Image src={omniImage} alt="" widths={[480, 850]} sizes="(min-width: 48rem) 50vw, 100vw" />
			<div class="product-body">
				<p class="product-status">{t(lang, 'home.omni.status')}</p>
				<h3>Omni</h3>
				<p class="product-tagline">{t(lang, 'home.omni.tagline')}</p>
				<p>{t(lang, 'home.omni.body')}</p>
				<span class="product-more">{t(lang, 'home.omni.more')} →</span>
			</div>
		</a>
	</section>
</SiteLayout>

<style>
	.home-hero {
		padding-block: 5rem 1rem;
	}

	.home-hero h1 {
		font-size: clamp(2.25rem, 6vw, 3.5rem);
		letter-spacing: 0.04em;
		line-height: 1.1;
		margin: 0 0 1rem;
	}

	.product-card {
		display: grid;
		grid-template-columns: 1fr;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 0.75rem;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s;
	}

	.product-card:hover {
		border-color: var(--accent);
	}

	@media (min-width: 48rem) {
		.product-card {
			grid-template-columns: 1fr 1fr;
		}
	}

	.product-card :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 16 / 9;
		background: #000;
	}

	.product-body {
		padding: 1.75rem;
	}

	.product-body h3 {
		font-size: 1.75rem;
		margin: 0.25rem 0 0.5rem;
	}

	.product-status {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0;
	}

	.product-tagline {
		font-weight: 600;
	}

	.product-body p:not(.product-status) {
		margin: 0 0 0.75rem;
	}

	.product-more {
		color: var(--accent);
		font-weight: 600;
	}
</style>
